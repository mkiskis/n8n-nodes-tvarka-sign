{
  "name": "TVARKA - request signatures and download completed document",
  "nodes": [
    {
      "id": "start",
      "name": "Start",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "inputs",
      "name": "Inputs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "title",
              "name": "title",
              "value": "Contract for signature",
              "type": "string"
            },
            {
              "id": "token",
              "name": "fileToken",
              "value": "REPLACE_WITH_UPLOAD_FILE_TOKEN",
              "type": "string"
            },
            {
              "id": "filename",
              "name": "documentName",
              "value": "contract.pdf",
              "type": "string"
            },
            {
              "id": "email",
              "name": "signerEmail",
              "value": "signer@example.com",
              "type": "string"
            },
            {
              "id": "key",
              "name": "idempotencyKey",
              "value": "REPLACE_WITH_UNIQUE_BUSINESS_REQUEST_KEY",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "create",
      "name": "Request signatures",
      "type": "n8n-nodes-tvarka-sign.tvarkaSign",
      "typeVersion": 1,
      "position": [
        460,
        0
      ],
      "parameters": {
        "resource": "signing",
        "operation": "create",
        "title": "={{ $json.title }}",
        "fileToken": "={{ $json.fileToken }}",
        "documentName": "={{ $json.documentName }}",
        "idempotencyKey": "={{ $json.idempotencyKey }}",
        "signers": {
          "signer": [
            {
              "email": "={{ $json.signerEmail }}",
              "name": "",
              "language": "en"
            }
          ]
        },
        "delivery": "email",
        "additionalFields": {
          "expiresInDays": 7
        }
      }
    },
    {
      "id": "wait",
      "name": "Wait five minutes",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        700,
        0
      ],
      "parameters": {
        "resume": "timeInterval",
        "amount": 5,
        "unit": "minutes"
      }
    },
    {
      "id": "status",
      "name": "Check status",
      "type": "n8n-nodes-tvarka-sign.tvarkaSign",
      "typeVersion": 1,
      "position": [
        940,
        0
      ],
      "parameters": {
        "resource": "signing",
        "operation": "get",
        "signingId": "={{ $json.signingId }}"
      }
    },
    {
      "id": "completed",
      "name": "Completed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1180,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "completed-condition",
              "leftValue": "={{ $json.status }}",
              "rightValue": "completed",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "download",
      "name": "Download completed document",
      "type": "n8n-nodes-tvarka-sign.tvarkaSign",
      "typeVersion": 1,
      "position": [
        1420,
        -140
      ],
      "parameters": {
        "resource": "signing",
        "operation": "download",
        "signingId": "={{ $json.signingId }}",
        "outputBinaryField": "data"
      }
    },
    {
      "id": "pending",
      "name": "Still pending?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1420,
        140
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "pending-condition",
              "leftValue": "={{ $json.status }}",
              "rightValue": "pending",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "note",
      "name": "Setup instructions",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        180,
        -400
      ],
      "parameters": {
        "content": "## Before running\nInstall the TVARKA node and select your credential in every TVARKA node. Upload the document with File > Upload, then replace all Inputs values. This workflow sends invitation emails. Use a stable, unique business request key. Connect the download to your storage node. Sandbox artifacts are not signed documents. Other terminal states end the workflow without downloading.",
        "height": 280,
        "width": 580
      }
    }
  ],
  "connections": {
    "Start": {
      "main": [
        [
          {
            "node": "Inputs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Inputs": {
      "main": [
        [
          {
            "node": "Request signatures",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Request signatures": {
      "main": [
        [
          {
            "node": "Wait five minutes",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait five minutes": {
      "main": [
        [
          {
            "node": "Check status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check status": {
      "main": [
        [
          {
            "node": "Completed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Completed?": {
      "main": [
        [
          {
            "node": "Download completed document",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Still pending?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Still pending?": {
      "main": [
        [
          {
            "node": "Wait five minutes",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "tags": []
}
